{
  "name": "comeet-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "dev:cloud": "vite --host 0.0.0.0",
    "build:pages": "tsc --noEmit && vite build --mode pages --base=/comeet/ --outDir ../artifacts/pages --emptyOutDir"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.5",
    "lucide-react": "0.548.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "@playwright/test": "1.56.1"
  }
}
