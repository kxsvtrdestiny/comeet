APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/comeet.db
# Initialize locally: go run ./cmd/server -env-file .env -init-env
# A private stable JWT secret (32+ bytes) is required; never commit .env.
JWT_SECRET=
JWT_ISSUER=comeet
JWT_AUDIENCE=comeet-web
JWT_TTL_HOURS=8
# LiveKit Cloud: https://your-project.livekit.cloud ; browser URL uses wss://
# Fill ONLY this private server/.env. Never use VITE_ variables for keys.
LIVEKIT_API_URL=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MAX_PARTICIPANTS=6
MEETING_EMPTY_TIMEOUT_MINUTES=10
MEETING_MAX_DURATION_MINUTES=240
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model ID will be verified when stage 7 starts.
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_OUTPUT_TOKENS=2048
