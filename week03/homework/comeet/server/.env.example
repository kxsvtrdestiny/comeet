APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/comeet.db
# Initialize locally: go run ./cmd/server -env-file .env -init-env
# A private stable JWT secret (32+ bytes) is required; never commit .env.
JWT_SECRET=
JWT_ISSUER=comeet
JWT_AUDIENCE=comeet-web
JWT_TTL_HOURS=8
# LiveKit Cloud: https://your-project.livekit.cloud ; browser URL uses wss://
# Fill ONLY this private server/.env. Never use VITE_ variables for keys.
LIVEKIT_API_URL=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MAX_PARTICIPANTS=6
MEETING_EMPTY_TIMEOUT_MINUTES=10
MEETING_MAX_DURATION_MINUTES=240
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set an exact model ID available to YOUR account; query /models locally.
# Key belongs only in this private server/.env, never VITE_ variables.
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_OUTPUT_TOKENS=2048

# Stage 6: 0 seconds keeps the minute-based defaults above (10 minutes / 240 minutes).
MEETING_EMPTY_TIMEOUT_SECONDS=0
MEETING_MAX_DURATION_SECONDS=0
MEETING_SWEEP_SECONDS=5
API_READS_PER_MINUTE=600
API_WRITES_PER_MINUTE=120
MEETING_CREATES_PER_MINUTE=20

# Stage 7: conservative source budget, not exact token accounting.
DEEPSEEK_MAX_SOURCE_CHARS=20000
DEEPSEEK_MAX_SOURCE_BYTES=80000
